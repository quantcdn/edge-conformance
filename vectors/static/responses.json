    {
      "id": "static-range-request",
      "description": "A byte range request gets 206 and the bytes in the range.",
      "tags": [
        "static"
      ],
      "op": "serveStatic",
      "input": {
        "files": {
          "index.html": "<h1>Home</h1>",
          "about/index.html": "<h1>About</h1>",
          "docs/guide/intro/index.html": "<h1>Intro</h1>",
          "contact.html": "<h1>Contact</h1>",
          "css/site.css": "body { color: #000; }",
          "js/app.js": "console.log(\"app\");",
          "data/items.json": "{\"items\":[]}",
          "img/logo.svg": "<svg xmlns=\"http://www.w3.org/2000/svg\"></svg>",
          "files/digits.txt": "0123456789",
          "_quant404/index.html": "<h1>Not here</h1>"
        },
        "request": {
          "method": "GET",
          "url": "https://www.example.com/files/digits.txt",
          "headers": {
            "range": "bytes=2-5"
          }
        }
      },
      "expect": {
        "status": 206,
        "headers": {
          "content-range": "bytes 2-5/10"
        },
        "bodyText": "2345"
      }
    },
    {
      "id": "static-range-suffix",
      "description": "A suffix range gets the last bytes of the file.",
      "tags": [
        "static"
      ],
      "op": "serveStatic",
      "input": {
        "files": {
          "index.html": "<h1>Home</h1>",
          "about/index.html": "<h1>About</h1>",
          "docs/guide/intro/index.html": "<h1>Intro</h1>",
          "contact.html": "<h1>Contact</h1>",
          "css/site.css": "body { color: #000; }",
          "js/app.js": "console.log(\"app\");",
          "data/items.json": "{\"items\":[]}",
          "img/logo.svg": "<svg xmlns=\"http://www.w3.org/2000/svg\"></svg>",
          "files/digits.txt": "0123456789",
          "_quant404/index.html": "<h1>Not here</h1>"
        },
        "request": {
          "method": "GET",
          "url": "https://www.example.com/files/digits.txt",
          "headers": {
            "range": "bytes=-3"
          }
        }
      },
      "expect": {
        "status": 206,
        "headers": {
          "content-range": "bytes 7-9/10"
        },
        "bodyText": "789"
      }
    },
