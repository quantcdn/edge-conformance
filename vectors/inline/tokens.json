    {
      "id": "inline-filter-before-tokens",
      "description": "A content filter runs before the tokens are replaced, so a token that the filter adds is replaced.",
      "tags": [
        "inline",
        "unverified"
      ],
      "op": "serveSite",
      "input": {
        "files": {
          "index.html": "<html><body><div>MARK</div></body></html>"
        },
        "functions": [
          {
            "uuid": "c3d4e5f6-0001-4000-8000-000000000001",
            "id": "hello",
            "type": "function",
            "body": "return new Response(\"Hello\", { status: 200, headers: {\"content-type\": \"text/plain\"} });"
          },
          {
            "uuid": "c3d4e5f6-0003-4000-8000-000000000003",
            "id": "marker",
            "type": "filter",
            "body": "class contentFilter extends TransformStream {\n  constructor(event, responseHeaders) {\n    super({\n      transform: (chunk, controller) => {\n        const text = this.textDecoder.decode(chunk);\n        controller.enqueue(this.textEncoder.encode(text.replace(/MARK/g, \"{{QUANT_FN:c3d4e5f6-0001-4000-8000-000000000001}}\")));\n      }\n    });\n    this.textEncoder = new TextEncoder();\n    this.textDecoder = new TextDecoder();\n  }\n}"
          }
        ],
        "rules": {
          "version": 1,
          "namespace": "conformance",
          "rules": [
            {
              "id": "marker",
              "type": "filter",
              "urls": [
                "/",
                "/*"
              ],
              "weight": 0,
              "function_uuid": "c3d4e5f6-0003-4000-8000-000000000003"
            }
          ]
        },
        "meta": {
          "project_settings": {
            "enable_inline_fn": true
          }
        },
        "request": {
          "method": "GET",
          "url": "https://www.example.com/"
        }
      },
      "expect": {
        "status": 200,
        "bodyIncludes": [
          "<div>Hello</div>"
        ]
      }
    },
    {
      "id": "inline-filter-does-not-see-output",
      "description": "A content filter does not change the output of an inline function.",
      "tags": [
        "inline",
        "unverified"
      ],
      "op": "serveSite",
      "input": {
        "files": {
          "index.html": "<html><body><div>{{QUANT_FN:c3d4e5f6-0001-4000-8000-000000000001}}</div></body></html>"
        },
        "functions": [
          {
            "uuid": "c3d4e5f6-0001-4000-8000-000000000001",
            "id": "hello",
            "type": "function",
            "body": "return new Response(\"Hello\", { status: 200, headers: {\"content-type\": \"text/plain\"} });"
          },
          {
            "uuid": "c3d4e5f6-0003-4000-8000-000000000003",
            "id": "bye",
            "type": "filter",
            "body": "class contentFilter extends TransformStream {\n  constructor(event, responseHeaders) {\n    super({\n      transform: (chunk, controller) => {\n        const text = this.textDecoder.decode(chunk);\n        controller.enqueue(this.textEncoder.encode(text.replace(/Hello/g, \"Bye\")));\n      }\n    });\n    this.textEncoder = new TextEncoder();\n    this.textDecoder = new TextDecoder();\n  }\n}"
          }
        ],
        "rules": {
          "version": 1,
          "namespace": "conformance",
          "rules": [
            {
              "id": "bye",
              "type": "filter",
              "urls": [
                "/",
                "/*"
              ],
              "weight": 0,
              "function_uuid": "c3d4e5f6-0003-4000-8000-000000000003"
            }
          ]
        },
        "meta": {
          "project_settings": {
            "enable_inline_fn": true
          }
        },
        "request": {
          "method": "GET",
          "url": "https://www.example.com/"
        }
      },
      "expect": {
        "status": 200,
        "bodyIncludes": [
          "<div>Hello</div>"
        ],
        "bodyExcludes": [
          "Bye"
        ]
      }
    },
