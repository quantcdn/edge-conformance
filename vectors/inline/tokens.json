    {
      "id": "inline-sees-page-path",
      "description": "The function gets the page request: its event.url has the page path and its request has the page method.",
      "tags": [
        "inline",
        "unverified"
      ],
      "op": "serveSite",
      "input": {
        "files": {
          "about/index.html": "<html><body><div>{{QUANT_FN:c3d4e5f6-0001-4000-8000-000000000001}}</div></body></html>"
        },
        "functions": [
          {
            "uuid": "c3d4e5f6-0001-4000-8000-000000000001",
            "id": "where",
            "type": "function",
            "body": "return new Response(event.url.pathname + ' ' + event.request.method);"
          }
        ],
        "meta": {
          "project_settings": {
            "enable_inline_fn": true
          }
        },
        "request": {
          "method": "GET",
          "url": "https://www.example.com/about/"
        }
      },
      "expect": {
        "status": 200,
        "bodyIncludes": [
          "<div>/about/ GET</div>"
        ]
      }
    },
