{
  "cases": [
    {
      "id": "inline-token-replaced",
      "description": "With inline functions on, the token in a static HTML page is replaced by the output of the function.",
      "tags": [
        "inline"
      ],
      "op": "serveSite",
      "input": {
        "files": {
          "index.html": "<html><body><div>{{QUANT_FN:c3d4e5f6-0001-4000-8000-000000000001}}</div></body></html>"
        },
        "functions": [
          {
            "uuid": "c3d4e5f6-0001-4000-8000-000000000001",
            "id": "hello",
            "type": "function",
            "body": "return new Response(\"Hello\", { status: 200, headers: {\"content-type\": \"text/plain\"} });"
          }
        ],
        "meta": {
          "project_settings": {
            "enable_inline_fn": true
          }
        },
        "request": {
          "method": "GET",
          "url": "https://www.example.com/"
        }
      },
      "expect": {
        "status": 200,
        "bodyIncludes": [
          "<div>Hello</div>"
        ],
        "bodyExcludes": [
          "{{QUANT_FN"
        ]
      }
    },
    {
