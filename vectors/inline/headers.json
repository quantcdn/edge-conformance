{
  "cases": [
    {
      "id": "inline-default-private-cache",
      "description": "A page with a token gets cache-control: private, max-age=0 when the function sets no cache-control.",
      "tags": [
        "inline"
      ],
      "op": "serveSite",
      "input": {
        "files": {
          "index.html": "<html><body><div>{{QUANT_FN:c3d4e5f6-0001-4000-8000-000000000001}}</div></body></html>"
        },
        "functions": [
          {
            "uuid": "c3d4e5f6-0001-4000-8000-000000000001",
            "id": "hello",
            "type": "function",
            "body": "return new Response(\"Hello\", { status: 200, headers: {\"content-type\": \"text/plain\"} });"
          }
        ],
        "meta": {
          "project_settings": {
            "enable_inline_fn": true
          }
        },
        "request": {
          "method": "GET",
          "url": "https://www.example.com/"
        }
      },
      "expect": {
        "status": 200,
        "headers": {
          "cache-control": "private, max-age=0"
        }
      }
    },
    {
      "id": "inline-function-cache-control",
      "description": "When the function sets cache-control, the page has that value.",
      "tags": [
        "inline",
        "unverified"
      ],
      "op": "serveSite",
      "input": {
        "files": {
          "index.html": "<html><body><div>{{QUANT_FN:c3d4e5f6-0001-4000-8000-000000000001}}</div></body></html>"
        },
        "functions": [
          {
            "uuid": "c3d4e5f6-0001-4000-8000-000000000001",
            "id": "hello",
            "type": "function",
            "body": "return new Response(\"Hello\", { status: 200, headers: {\"content-type\": \"text/plain\", \"cache-control\": \"public, max-age=60\"} });"
          }
        ],
        "meta": {
          "project_settings": {
            "enable_inline_fn": true
          }
        },
        "request": {
          "method": "GET",
          "url": "https://www.example.com/"
        }
      },
      "expect": {
        "status": 200,
        "headers": {
          "cache-control": "public, max-age=60"
        }
      }
    },
    {
      "id": "inline-function-header-on-page",
      "description": "A header that the function sets is on the page response.",
      "tags": [
        "inline",
        "unverified"
      ],
      "op": "serveSite",
      "input": {
        "files": {
          "index.html": "<html><body><div>{{QUANT_FN:c3d4e5f6-0001-4000-8000-000000000001}}</div></body></html>"
        },
        "functions": [
          {
            "uuid": "c3d4e5f6-0001-4000-8000-000000000001",
            "id": "hello",
            "type": "function",
            "body": "return new Response(\"Hello\", { status: 200, headers: {\"content-type\": \"text/plain\", \"x-fn\": \"1\"} });"
          }
        ],
        "meta": {
          "project_settings": {
            "enable_inline_fn": true
          }
        },
        "request": {
          "method": "GET",
          "url": "https://www.example.com/"
        }
      },
      "expect": {
        "status": 200,
        "headers": {
          "x-fn": "1"
        }
      }
    },
