    {
      "id": "inline-invalid-token-private",
      "description": "A page with only a token that does not hold a full UUID keeps the token, and gets cache-control: private, max-age=0.",
      "tags": [
        "inline",
        "unverified"
      ],
      "op": "serveSite",
      "input": {
        "files": {
          "index.html": "<html><body><div>{{QUANT_FN:x}}</div></body></html>"
        },
        "functions": [
          {
            "uuid": "c3d4e5f6-0001-4000-8000-000000000001",
            "id": "hello",
            "type": "function",
            "body": "return new Response(\"Hello\", { status: 200, headers: {\"content-type\": \"text/plain\"} });"
          }
        ],
        "meta": {
          "project_settings": {
            "enable_inline_fn": true
          }
        },
        "request": {
          "method": "GET",
          "url": "https://www.example.com/"
        }
      },
      "expect": {
        "status": 200,
        "headers": {
          "cache-control": "private, max-age=0"
        },
        "bodyIncludes": [
          "{{QUANT_FN:x}}"
        ]
      }
    },
    {
      "id": "inline-global-cache-control",
      "description": "A project-wide cache-control header is used on a page with a token when the function sets no cache-control.",
      "tags": [
        "inline",
        "unverified"
      ],
      "op": "serveSite",
      "input": {
        "files": {
          "index.html": "<html><body><div>{{QUANT_FN:c3d4e5f6-0001-4000-8000-000000000001}}</div></body></html>"
        },
        "functions": [
          {
            "uuid": "c3d4e5f6-0001-4000-8000-000000000001",
            "id": "hello",
            "type": "function",
            "body": "return new Response(\"Hello\", { status: 200, headers: {\"content-type\": \"text/plain\"} });"
          }
        ],
        "meta": {
          "project_settings": {
            "enable_inline_fn": true
          }
        },
        "project": {
          "globalHeaders": {
            "cache-control": "public, max-age=60"
          }
        },
        "request": {
          "method": "GET",
          "url": "https://www.example.com/"
        }
      },
      "expect": {
        "status": 200,
        "headers": {
          "cache-control": "public, max-age=60"
        }
      }
    }
