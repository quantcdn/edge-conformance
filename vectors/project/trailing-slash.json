{
  "cases": [
    {
      "id": "project-slash-redirect",
      "description": "With the trailing-slash redirect on, a path that ends with / gets a 301 to the path without it.",
      "tags": [
        "project",
        "unverified"
      ],
      "op": "serveSite",
      "input": {
        "files": {
          "index.html": "<h1>Home</h1>",
          "about/index.html": "<h1>About</h1>",
          "css/site.css": "body { color: #000; }"
        },
        "project": {
          "trailingSlash": "redirect"
        },
        "request": {
          "method": "GET",
          "url": "https://www.example.com/about/"
        }
      },
      "expect": {
        "status": 301,
        "headers": {
          "location": "/about"
        }
      }
    },
    {
      "id": "project-slash-redirect-keeps-query",
      "description": "The trailing-slash redirect keeps the query string.",
      "tags": [
        "project",
        "unverified"
      ],
      "op": "serveSite",
      "input": {
        "files": {
          "index.html": "<h1>Home</h1>",
          "about/index.html": "<h1>About</h1>",
          "css/site.css": "body { color: #000; }"
        },
        "project": {
          "trailingSlash": "redirect"
        },
        "request": {
          "method": "GET",
          "url": "https://www.example.com/about/?a=1"
        }
      },
      "expect": {
        "status": 301,
        "headers": {
          "location": "/about?a=1"
        }
      }
    },
    {
      "id": "project-slash-redirect-cache",
      "description": "The trailing-slash redirect can be cached for a short time.",
      "tags": [
        "project",
        "unverified"
      ],
      "op": "serveSite",
      "input": {
        "files": {
          "index.html": "<h1>Home</h1>",
          "about/index.html": "<h1>About</h1>",
          "css/site.css": "body { color: #000; }"
        },
        "project": {
          "trailingSlash": "redirect"
        },
        "request": {
          "method": "GET",
          "url": "https://www.example.com/about/"
        }
      },
      "expect": {
        "status": 301,
        "headers": {
          "cache-control": "public, max-age=300, s-maxage=86400"
        }
      }
    },
    {
      "id": "project-slash-home-not-redirected",
