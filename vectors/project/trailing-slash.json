    {
      "id": "project-slash-rule-path-not-redirected",
      "description": "A path that a function rule answers is not redirected.",
      "tags": [
        "project",
        "unverified"
      ],
      "op": "serveSite",
      "input": {
        "files": {
          "index.html": "<h1>Home</h1>",
          "about/index.html": "<h1>About</h1>",
          "css/site.css": "body { color: #000; }"
        },
        "functions": [
          {
            "uuid": "d4e5f6a7-0001-4000-8000-000000000001",
            "id": "api",
            "type": "function",
            "body": "return new Response(\"from function\", { status: 200, headers: {\"content-type\": \"text/plain\"} });"
          }
        ],
        "rules": {
          "version": 1,
          "namespace": "conformance",
          "rules": [
            {
              "id": "api",
              "type": "function",
              "urls": [
                "/api/*"
              ],
              "weight": 0,
              "function_uuid": "d4e5f6a7-0001-4000-8000-000000000001"
            }
          ]
        },
        "project": {
          "trailingSlash": "redirect"
        },
        "request": {
          "method": "GET",
          "url": "https://www.example.com/api/x/"
        }
      },
      "expect": {
        "status": 200,
        "bodyText": "from function",
        "headers": {
          "location": null
        }
      }
    },
    {
      "id": "project-slash-auth-first",
      "description": "Basic authentication applies before the trailing-slash redirect.",
      "tags": [
        "project",
        "unverified"
      ],
      "op": "serveSite",
      "input": {
        "files": {
          "index.html": "<h1>Home</h1>",
          "about/index.html": "<h1>About</h1>",
          "css/site.css": "body { color: #000; }"
        },
        "project": {
          "basicAuth": {
            "username": "u",
            "password": "p"
          },
          "trailingSlash": "redirect"
        },
        "request": {
          "method": "GET",
          "url": "https://www.example.com/about/"
        }
      },
      "expect": {
        "status": 401,
        "headers": {
          "location": null
        }
      }
    },
    {
