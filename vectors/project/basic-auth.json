{
  "cases": [
    {
      "id": "project-auth-no-credentials",
      "description": "With basic authentication on, a request without credentials gets 401.",
      "tags": [
        "project"
      ],
      "op": "serveSite",
      "input": {
        "files": {
          "index.html": "<h1>Home</h1>",
          "about/index.html": "<h1>About</h1>",
          "css/site.css": "body { color: #000; }"
        },
        "project": {
          "basicAuth": {
            "username": "u",
            "password": "p"
          }
        },
        "request": {
          "method": "GET",
          "url": "https://www.example.com/"
        }
      },
      "expect": {
        "status": 401,
        "bodyExcludes": [
          "Home"
        ]
      }
    },
    {
      "id": "project-auth-correct-credentials",
      "description": "With basic authentication on, a request with the correct credentials gets the page.",
      "tags": [
        "project"
      ],
      "op": "serveSite",
      "input": {
        "files": {
          "index.html": "<h1>Home</h1>",
          "about/index.html": "<h1>About</h1>",
          "css/site.css": "body { color: #000; }"
        },
        "project": {
          "basicAuth": {
            "username": "u",
            "password": "p"
          }
        },
        "request": {
          "method": "GET",
          "url": "https://www.example.com/",
          "headers": {
            "authorization": "Basic dTpw"
          }
        }
      },
      "expect": {
        "status": 200,
        "bodyText": "<h1>Home</h1>"
      }
    },
    {
