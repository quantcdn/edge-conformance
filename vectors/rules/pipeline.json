      }
    },
    {
      "id": "rules-auth-201-continues",
      "description": "An auth function that returns 201 lets the request continue to the static file.",
      "tags": [
        "rules"
      ],
      "op": "serveSite",
      "input": {
        "files": {
          "members/report/index.html": "<h1>Members report</h1>",
          "index.html": "<h1>Home</h1>"
        },
        "functions": [
          {
            "uuid": "a1b2c3d4-0003-4000-8000-000000000003",
            "id": "gate",
            "type": "auth",
            "body": "return new Response('ok', { status: 201 });"
          }
        ],
        "rules": {
          "version": 1,
          "namespace": "conformance",
          "rules": [
            {
              "id": "members",
              "type": "auth",
              "urls": [
                "/members/*"
              ],
              "weight": 0,
              "function_uuid": "a1b2c3d4-0003-4000-8000-000000000003"
            }
          ]
        },
        "request": {
          "method": "GET",
          "url": "https://www.example.com/members/report/"
        }
      },
      "expect": {
        "status": 200,
        "bodyText": "<h1>Members report</h1>"
      }
    },
    {
      "id": "rules-auth-201-adds-its-headers-but-not-content-type",
      "description": "The headers of a 201 auth response are added to the final response, except content-type.",
      "tags": [
        "rules"
      ],
      "op": "serveSite",
      "input": {
        "files": {
          "members/report/index.html": "<h1>Members report</h1>",
          "index.html": "<h1>Home</h1>"
        },
        "functions": [
          {
            "uuid": "a1b2c3d4-0003-4000-8000-000000000003",
            "id": "gate",
            "type": "auth",
            "body": "return new Response('ok', { status: 201, headers: { 'x-member': 'ada', 'content-type': 'text/plain' } });"
          }
        ],
        "rules": {
          "version": 1,
          "namespace": "conformance",
          "rules": [
            {
              "id": "members",
              "type": "auth",
              "urls": [
                "/members/*"
              ],
              "weight": 0,
              "function_uuid": "a1b2c3d4-0003-4000-8000-000000000003"
            }
          ]
        },
        "request": {
          "method": "GET",
          "url": "https://www.example.com/members/report/"
        }
      },
      "expect": {
        "status": 200,
        "headers": {
          "x-member": "ada",
          "content-type": {
            "startsWith": "text/html"
          }
        },
        "bodyText": "<h1>Members report</h1>"
      }
    },
    {
      "id": "rules-auth-201-default-cache-control",
      "description": "When a 201 auth response sets no cache-control, the final response gets private, max-age=0.",
      "tags": [
        "rules"
      ],
      "op": "serveSite",
      "input": {
        "files": {
          "members/report/index.html": "<h1>Members report</h1>",
          "index.html": "<h1>Home</h1>"
        },
        "functions": [
          {
            "uuid": "a1b2c3d4-0003-4000-8000-000000000003",
            "id": "gate",
            "type": "auth",
            "body": "return new Response('ok', { status: 201 });"
          }
        ],
        "rules": {
          "version": 1,
          "namespace": "conformance",
          "rules": [
            {
              "id": "members",
              "type": "auth",
              "urls": [
                "/members/*"
              ],
              "weight": 0,
              "function_uuid": "a1b2c3d4-0003-4000-8000-000000000003"
            }
          ]
        },
        "request": {
          "method": "GET",
          "url": "https://www.example.com/members/report/"
        }
      },
      "expect": {
        "status": 200,
        "headers": {
          "cache-control": "private, max-age=0"
        }
      }
    },
    {
      "id": "rules-auth-201-keeps-its-cache-control",
      "description": "A cache-control on a 201 auth response is kept on the final response.",
      "tags": [
        "rules"
      ],
      "op": "serveSite",
      "input": {
        "files": {
          "members/report/index.html": "<h1>Members report</h1>",
          "index.html": "<h1>Home</h1>"
        },
        "functions": [
          {
            "uuid": "a1b2c3d4-0003-4000-8000-000000000003",
            "id": "gate",
            "type": "auth",
            "body": "return new Response('ok', { status: 201, headers: { 'cache-control': 'private, max-age=30' } });"
          }
        ],
        "rules": {
          "version": 1,
          "namespace": "conformance",
          "rules": [
            {
              "id": "members",
              "type": "auth",
              "urls": [
                "/members/*"
              ],
              "weight": 0,
              "function_uuid": "a1b2c3d4-0003-4000-8000-000000000003"
            }
          ]
        },
        "request": {
          "method": "GET",
          "url": "https://www.example.com/members/report/"
        }
      },
      "expect": {
        "status": 200,
        "headers": {
          "cache-control": "private, max-age=30"
        }
      }
    },
    {
      "id": "rules-auth-denies",
      "description": "An auth function that returns another status ends the request with its response.",
      "tags": [
        "rules"
      ],
      "op": "serveSite",
      "input": {
        "files": {
          "members/report/index.html": "<h1>Members report</h1>",
          "index.html": "<h1>Home</h1>"
        },
        "functions": [
          {
            "uuid": "a1b2c3d4-0003-4000-8000-000000000003",
            "id": "gate",
            "type": "auth",
            "body": "return new Response('Sign in to continue', { status: 401, headers: { 'www-authenticate': 'Basic realm=Members' } });"
          }
        ],
        "rules": {
          "version": 1,
          "namespace": "conformance",
          "rules": [
            {
              "id": "members",
              "type": "auth",
              "urls": [
                "/members/*"
              ],
              "weight": 0,
              "function_uuid": "a1b2c3d4-0003-4000-8000-000000000003"
            }
          ]
        },
        "request": {
          "method": "GET",
          "url": "https://www.example.com/members/report/"
        }
      },
      "expect": {
        "status": 401,
        "headers": {
          "www-authenticate": "Basic realm=Members"
        },
        "bodyText": "Sign in to continue"
      }
    },
    {
      "id": "rules-auth-redirects",
      "description": "An auth function can end the request with a redirect.",
      "tags": [
        "rules"
      ],
      "op": "serveSite",
      "input": {
        "files": {
          "members/report/index.html": "<h1>Members report</h1>",
          "index.html": "<h1>Home</h1>"
        },
        "functions": [
          {
            "uuid": "a1b2c3d4-0003-4000-8000-000000000003",
            "id": "gate",
            "type": "auth",
            "body": "return new Response('', { status: 302, headers: { location: '/login' } });"
          }
        ],
        "rules": {
          "version": 1,
          "namespace": "conformance",
          "rules": [
            {
              "id": "members",
              "type": "auth",
              "urls": [
                "/members/*"
              ],
              "weight": 0,
              "function_uuid": "a1b2c3d4-0003-4000-8000-000000000003"
            }
          ]
        },
        "request": {
          "method": "GET",
          "url": "https://www.example.com/members/report/"
        }
      },
      "expect": {
        "status": 302,
        "headers": {
          "location": "/login"
        }
      }
    },
