{
  "cases": [
    {
      "id": "rules-function-rule-before-static",
      "description": "A matching function rule answers the request, although a static file exists at the path.",
      "tags": [
        "rules"
      ],
      "op": "serveSite",
      "input": {
        "files": {
          "api/status/index.html": "<p>static status</p>"
        },
        "functions": [
          {
            "uuid": "a1b2c3d4-0001-4000-8000-000000000001",
            "id": "api",
            "type": "function",
            "body": "return new Response(\"from function\", { status: 200, headers: { 'content-type': 'text/plain' } });"
          }
        ],
        "rules": {
          "version": 1,
          "namespace": "conformance",
          "rules": [
            {
              "id": "api",
              "type": "function",
              "urls": [
                "/api/*"
              ],
              "weight": 0,
              "function_uuid": "a1b2c3d4-0001-4000-8000-000000000001"
            }
          ]
        },
        "request": {
          "method": "GET",
          "url": "https://www.example.com/api/status"
        }
      },
      "expect": {
        "status": 200,
        "bodyText": "from function"
      }
    },
    {
