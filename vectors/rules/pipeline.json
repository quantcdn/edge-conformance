          "namespace": "conformance",
          "rules": [
            {
              "id": "api",
              "type": "function",
              "urls": [
                "/api/*"
              ],
              "weight": 0,
              "function_uuid": "a1b2c3d4-0001-4000-8000-000000000001"
            }
          ]
        },
        "request": {
          "method": "GET",
          "url": "https://www.example.com/about/"
