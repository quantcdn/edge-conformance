    {
      "id": "rules-auth-201-then-function-rule",
      "description": "After a 201 auth response, the next matching rule runs.",
      "tags": [
        "rules"
      ],
      "op": "serveSite",
      "input": {
        "files": {
          "members/report/index.html": "<h1>Members report</h1>",
          "index.html": "<h1>Home</h1>"
        },
        "functions": [
          {
            "uuid": "a1b2c3d4-0003-4000-8000-000000000003",
            "id": "gate",
            "type": "auth",
            "body": "return new Response('ok', { status: 201 });"
          },
          {
            "uuid": "a1b2c3d4-0001-4000-8000-000000000001",
            "id": "api",
            "type": "function",
            "body": "return new Response(\"members api\", { status: 200, headers: { 'content-type': 'text/plain' } });"
          }
        ],
        "rules": {
          "version": 1,
          "namespace": "conformance",
          "rules": [
            {
              "id": "members",
              "type": "auth",
              "urls": [
                "/members/*"
              ],
              "weight": 0,
              "function_uuid": "a1b2c3d4-0003-4000-8000-000000000003"
            },
            {
              "id": "members-api",
              "type": "function",
              "urls": [
                "/members/*"
              ],
              "weight": 1,
              "function_uuid": "a1b2c3d4-0001-4000-8000-000000000001"
            }
          ]
        },
        "request": {
          "method": "GET",
          "url": "https://www.example.com/members/report/"
        }
      },
      "expect": {
        "status": 200,
        "bodyText": "members api"
      }
    },
    {
      "id": "rules-auth-chain",
      "description": "Auth rules chain: each must return 201 for the next one to run.",
      "tags": [
        "rules"
      ],
      "op": "serveSite",
      "input": {
        "files": {
          "members/report/index.html": "<h1>Members report</h1>",
          "index.html": "<h1>Home</h1>"
        },
        "functions": [
          {
            "uuid": "a1b2c3d4-0003-4000-8000-000000000003",
            "id": "gate",
            "type": "auth",
            "body": "return new Response('ok', { status: 201 });"
          },
          {
            "uuid": "a1b2c3d4-0005-4000-8000-000000000005",
            "id": "second-gate",
            "type": "auth",
            "body": "return new Response('Second check failed', { status: 403 });"
          }
        ],
        "rules": {
          "version": 1,
          "namespace": "conformance",
          "rules": [
            {
              "id": "first",
              "type": "auth",
              "urls": [
                "/members/*"
              ],
              "weight": 0,
              "function_uuid": "a1b2c3d4-0003-4000-8000-000000000003"
            },
            {
              "id": "second",
              "type": "auth",
              "urls": [
                "/members/*"
              ],
              "weight": 1,
              "function_uuid": "a1b2c3d4-0005-4000-8000-000000000005"
            }
          ]
        },
        "request": {
          "method": "GET",
          "url": "https://www.example.com/members/report/"
        }
      },
      "expect": {
        "status": 403,
        "bodyText": "Second check failed"
      }
    },
